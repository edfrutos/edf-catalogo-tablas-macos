@page "/help"

<PageTitle>Guía de Usuario - EDF Catálogo de Tablas</PageTitle>

<div class="row">
    <div class="col-12">
        <!-- Header con breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/" class="text-decoration-none">
                        <i class="fas fa-home me-1"></i>Inicio
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    <i class="fas fa-question-circle me-1"></i>Guía de Usuario
                </li>
            </ol>
        </nav>
        
        <!-- Título principal -->
        <div class="text-center mb-5">
            <i class="fas fa-book-open fa-3x text-primary mb-3"></i>
            <h1 class="display-5 fw-bold">Guía de Usuario</h1>
            <p class="lead text-muted">
                Todo lo que necesitas saber para usar el Catálogo de Tablas
                <br>
                <small>¡Explicado de forma súper sencilla!</small>
            </p>
        </div>
    </div>
</div>

<!-- Índice rápido -->
<div class="row mb-5">
    <div class="col-12">
        <div class="card bg-light">
            <div class="card-body">
                <h4 class="card-title">
                    <i class="fas fa-list me-2"></i>¿Qué quieres aprender?
                </h4>
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a href="#que-es" class="text-decoration-none">
                                    <i class="fas fa-question me-1"></i>¿Qué es un catálogo?
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="#crear-catalogo" class="text-decoration-none">
                                    <i class="fas fa-plus me-1"></i>Cómo crear un catálogo
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="#ver-catalogos" class="text-decoration-none">
                                    <i class="fas fa-eye me-1"></i>Cómo ver mis catálogos
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <a href="#buscar" class="text-decoration-none">
                                    <i class="fas fa-search me-1"></i>Cómo buscar catálogos
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="#consejos" class="text-decoration-none">
                                    <i class="fas fa-lightbulb me-1"></i>Consejos y trucos
                                </a>
                            </li>
                            <li class="mb-2">
                                <a href="#problemas" class="text-decoration-none">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Problemas comunes
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contenido de ayuda -->
<div class="row">
    <div class="col-12">
        
        <!-- ¿Qué es un catálogo? -->
        <section id="que-es" class="mb-5">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-question-circle me-2"></i>¿Qué es un catálogo?
                    </h3>
                </div>
                <div class="card-body">
                    <p class="lead">
                        Un catálogo es como una <strong>lista organizada</strong> donde puedes guardar información de forma ordenada.
                    </p>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Ejemplos de catálogos:</h5>
                            <ul>
                                <li><strong>Productos:</strong> Lista de artículos que vendes</li>
                                <li><strong>Empleados:</strong> Información de tu equipo</li> 
                                <li><strong>Clientes:</strong> Datos de contacto</li>
                                <li><strong>Inventario:</strong> Stock de tu almacén</li>
                                <li><strong>Proveedores:</strong> Empresas que te suministran</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-info">
                                <i class="fas fa-lightbulb me-2"></i>
                                <strong>Piensa en ello como:</strong>
                                <br>Una libreta digital súper organizada donde cada página es un catálogo diferente.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cómo crear un catálogo -->
        <section id="crear-catalogo" class="mb-5">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Cómo crear un catálogo
                    </h3>
                </div>
                <div class="card-body">
                    <p class="lead">¡Es súper fácil! Solo sigue estos pasos:</p>
                    
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="timeline">
                                <div class="d-flex mb-4">
                                    <div class="flex-shrink-0">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <strong>1</strong>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5>Ir a "Crear Catálogo"</h5>
                                        <p>Haz clic en el botón verde <strong>"Crear Nuevo"</strong> o <strong>"Crear Catálogo"</strong> desde cualquier página.</p>
                                    </div>
                                </div>
                                
                                <div class="d-flex mb-4">
                                    <div class="flex-shrink-0">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <strong>2</strong>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5>Rellenar el formulario</h5>
                                        <p>Completa los campos obligatorios:</p>
                                        <ul>
                                            <li><strong>Nombre:</strong> Elige algo descriptivo como "Productos 2025"</li>
                                            <li><strong>Descripción:</strong> Explica qué contiene tu catálogo</li>
                                            <li><strong>Categoría:</strong> (opcional) Para organizar mejor</li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <div class="d-flex mb-4">
                                    <div class="flex-shrink-0">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <strong>3</strong>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h5>Hacer clic en "Crear"</h5>
                                        <p>Presiona el botón azul <strong>"Crear Mi Catálogo"</strong> y ¡listo!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="text-center">
                                <a href="/create" class="btn btn-success btn-lg mb-3">
                                    <i class="fas fa-plus me-2"></i>Crear Catálogo Ahora
                                </a>
                                <div class="alert alert-warning">
                                    <i class="fas fa-clock me-2"></i>
                                    <strong>Solo toma 1 minuto</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cómo ver catálogos -->
        <section id="ver-catalogos" class="mb-5">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-eye me-2"></i>Cómo ver mis catálogos
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <p class="lead">Hay varias formas de ver tus catálogos:</p>
                            
                            <h5>1. Desde el menú principal</h5>
                            <p>Haz clic en <strong>"Ver Catálogos"</strong> en la barra de navegación.</p>
                            
                            <h5>2. Desde la página de inicio</h5>
                            <p>Usa el botón <strong>"Ver Catálogos Existentes"</strong> en la página principal.</p>
                            
                            <h5>3. Ver detalles de un catálogo</h5>
                            <p>En la lista de catálogos, haz clic en el botón <i class="fas fa-eye"></i> para ver todos los detalles.</p>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <a href="/catalogs" class="btn btn-info btn-lg">
                                    <i class="fas fa-list me-2"></i>Ver Mis Catálogos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cómo buscar -->
        <section id="buscar" class="mb-5">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0">
                        <i class="fas fa-search me-2"></i>Cómo buscar catálogos
                    </h3>
                </div>
                <div class="card-body">
                    <p class="lead">Si tienes muchos catálogos, puedes buscar fácilmente:</p>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Barra de búsqueda</h5>
                            <p>En la página "Ver Catálogos" hay una barra de búsqueda grande. Solo escribe:</p>
                            <ul>
                                <li>El nombre del catálogo</li>
                                <li>Parte de la descripción</li>
                                <li>La categoría</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-success">
                                <i class="fas fa-magic me-2"></i>
                                <strong>¡Es automático!</strong>
                                <br>
                                Los resultados aparecen mientras escribes, no necesitas hacer clic en ningún botón.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Consejos y trucos -->
        <section id="consejos" class="mb-5">
            <div class="card">
                <div class="card-header" style="background-color: #6f42c1; color: white;">
                    <h3 class="mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Consejos y trucos
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>✅ Buenos nombres para catálogos:</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">✓ "Productos Tienda Online 2025"</li>
                                <li class="mb-2">✓ "Empleados Departamento Ventas"</li>
                                <li class="mb-2">✓ "Clientes Madrid Centro"</li>
                                <li class="mb-2">✓ "Inventario Almacén Principal"</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>❌ Nombres a evitar:</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">✗ "Cosas"</li>
                                <li class="mb-2">✗ "Lista1"</li>
                                <li class="mb-2">✗ "aaaa"</li>
                                <li class="mb-2">✗ "Nuevo catálogo"</li>
                            </ul>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-12">
                            <h5>💡 Trucos útiles:</h5>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="alert alert-light">
                                        <strong>Usa categorías</strong><br>
                                        Organiza tus catálogos por tema: "Ventas", "Inventario", "Personal", etc.
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="alert alert-light">
                                        <strong>Descripciones claras</strong><br>
                                        Explica bien qué contiene cada catálogo para recordarlo después.
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="alert alert-light">
                                        <strong>Empieza simple</strong><br>
                                        Crea primero catálogos pequeños y sencillos para practicar.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Problemas comunes -->
        <section id="problemas" class="mb-5">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Problemas comunes y soluciones
                    </h3>
                </div>
                <div class="card-body">
                    <div class="accordion" id="problemsAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#problem1">
                                    No puedo crear un catálogo
                                </button>
                            </h2>
                            <div id="problem1" class="accordion-collapse collapse show" data-bs-parent="#problemsAccordion">
                                <div class="accordion-body">
                                    <strong>Posibles causas:</strong>
                                    <ul>
                                        <li>El nombre es muy corto (mínimo 3 caracteres)</li>
                                        <li>La descripción es muy corta (mínimo 10 caracteres)</li>
                                        <li>Has dejado campos obligatorios vacíos</li>
                                    </ul>
                                    <strong>Solución:</strong> Revisa que todos los campos marcados con * estén completos.
                                </div>
                            </div>
                        </div>
                        
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#problem2">
                                    No veo mis catálogos
                                </button>
                            </h2>
                            <div id="problem2" class="accordion-collapse collapse" data-bs-parent="#problemsAccordion">
                                <div class="accordion-body">
                                    <strong>Posibles causas:</strong>
                                    <ul>
                                        <li>Estás buscando y no encuentras resultados</li>
                                        <li>Aún no has creado ningún catálogo</li>
                                    </ul>
                                    <strong>Solución:</strong> 
                                    <ul>
                                        <li>Limpia la búsqueda haciendo clic en la ✗</li>
                                        <li>Ve a "Crear Catálogo" para crear tu primero</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#problem3">
                                    La página se ve rara o no funciona
                                </button>
                            </h2>
                            <div id="problem3" class="accordion-collapse collapse" data-bs-parent="#problemsAccordion">
                                <div class="accordion-body">
                                    <strong>Solución rápida:</strong>
                                    <ol>
                                        <li>Recarga la página (F5 o Ctrl+R)</li>
                                        <li>Cierra y abre el navegador</li>
                                        <li>Prueba con otro navegador (Chrome, Firefox, Edge)</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contacto y ayuda adicional -->
        <section class="mb-5">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-headset me-2"></i>¿Necesitas más ayuda?
                    </h3>
                </div>
                <div class="card-body text-center">
                    <p class="lead">Si tienes alguna duda que no está resuelta aquí, no te preocupes.</p>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light h-100">
                                <div class="card-body">
                                    <i class="fas fa-home fa-2x text-primary mb-2"></i>
                                    <h5>Volver al Inicio</h5>
                                    <p class="small">Regresa a la página principal</p>
                                    <a href="/" class="btn btn-outline-primary">Ir al Inicio</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light h-100">
                                <div class="card-body">
                                    <i class="fas fa-play fa-2x text-success mb-2"></i>
                                    <h5>Empezar a Practicar</h5>
                                    <p class="small">Crea tu primer catálogo</p>
                                    <a href="/create" class="btn btn-outline-success">Crear Catálogo</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-light h-100">
                                <div class="card-body">
                                    <i class="fas fa-info-circle fa-2x text-info mb-2"></i>
                                    <h5>Sobre la App</h5>
                                    <p class="small">Información técnica</p>
                                    <a href="/about" class="btn btn-outline-info">Saber Más</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>