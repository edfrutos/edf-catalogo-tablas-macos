@namespace EDFCatalogoTablasNet.Components.Shared
@using EDFCatalogoTablasNet.Models
@inject IJSRuntime JSRuntime
@inject ILogger<AddRowModal> Logger

<!-- Modal para agregar nueva fila -->
<div class="modal fade" id="addRowModal" tabindex="-1" aria-labelledby="addRowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRowModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Agregar Nueva Fila
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Headers.Length == 0)
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>No hay columnas definidas</strong>
                        <br>
                        Este catálogo no tiene columnas definidas. Primero debes editar el catálogo para agregar las cabeceras de las columnas.
                    </div>
                }
                else
                {
                    <form id="addRowForm">
                        <!-- Datos de las columnas -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-table me-2"></i>Datos de la Fila
                                </h6>
                            </div>
                        </div>

                        <div class="row">
                            @for (int i = 0; i < Headers.Length; i++)
                            {
                                var header = Headers[i];
                                var columnIndex = i;
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <label for="@($"column_{columnIndex}")" class="form-label fw-bold">
                                        @header
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           id="@($"column_{columnIndex}")"
                                           @bind="ColumnValues[columnIndex]"
                                           placeholder="Ingresa el valor para @header" />
                                </div>
                            }
                        </div>

                        <hr class="my-4">

                        <!-- Archivos de la fila -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="fw-bold mb-3">
                                    <i class="fas fa-paperclip me-2"></i>Archivos de la Fila
                                    <small class="text-muted">(opcional)</small>
                                </h6>
                                <p class="text-muted small">
                                    Puedes adjuntar archivos específicos a esta fila. Estos archivos aparecerán junto a los datos de la fila.
                                </p>
                            </div>
                        </div>

                        <!-- Documentos -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-bold mb-0">
                                        <i class="fas fa-file-pdf me-1"></i>Documentos
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddDocument">
                                        <i class="fas fa-plus me-1"></i>Más
                                    </button>
                                </div>
                                @foreach (var (docUrl, index) in DocumentUrls.Select((url, i) => (url, i)))
                                {
                                    <div class="mb-2 d-flex gap-2">
                                        <div class="flex-grow-1">
                                            <UploadFileComponent Label=""
                                                               FileType="documento"
                                                               Value="@docUrl"
                                                               ValueChanged="@((newValue) => UpdateDocument(index, newValue))" />
                                        </div>
                                        @if (DocumentUrls.Count > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger align-self-start" @onclick="() => RemoveDocument(index)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Multimedia -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-bold mb-0">
                                        <i class="fas fa-video me-1"></i>Multimedia
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddMultimedia">
                                        <i class="fas fa-plus me-1"></i>Más
                                    </button>
                                </div>
                                @foreach (var (multUrl, index) in MultimediaUrls.Select((url, i) => (url, i)))
                                {
                                    <div class="mb-2 d-flex gap-2">
                                        <div class="flex-grow-1">
                                            <UploadFileComponent Label=""
                                                               FileType="multimedia"
                                                               Value="@multUrl"
                                                               ValueChanged="@((newValue) => UpdateMultimedia(index, newValue))" />
                                        </div>
                                        @if (MultimediaUrls.Count > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger align-self-start" @onclick="() => RemoveMultimedia(index)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Imágenes -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-bold mb-0">
                                        <i class="fas fa-image me-1"></i>Imágenes
                                    </label>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddImage">
                                        <i class="fas fa-plus me-1"></i>Más
                                    </button>
                                </div>
                                @foreach (var (imgUrl, index) in ImageUrls.Select((url, i) => (url, i)))
                                {
                                    <div class="mb-2 d-flex gap-2">
                                        <div class="flex-grow-1">
                                            <UploadFileComponent Label=""
                                                               FileType="imagen"
                                                               Value="@imgUrl"
                                                               ValueChanged="@((newValue) => UpdateImage(index, newValue))" />
                                        </div>
                                        @if (ImageUrls.Count > 1)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger align-self-start" @onclick="() => RemoveImage(index)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Archivos adicionales -->
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0">
                                        <i class="fas fa-plus me-2"></i>Archivos Adicionales
                                    </h6>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddAdditionalFile">
                                        <i class="fas fa-plus me-1"></i>Agregar Archivo
                                    </button>
                                </div>

                                @if (AdditionalFiles.Any())
                                {
                                    @foreach (var (file, index) in AdditionalFiles.Select((f, i) => (f, i)))
                                    {
                                        <div class="card mb-2">
                                            <div class="card-body py-2">
                                                <div class="row align-items-center">
                                                    <div class="col-md-3">
                                                        <input type="text"
                                                               class="form-control form-control-sm"
                                                               placeholder="Descripción (opcional)"
                                                               @bind="file.Description" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <select class="form-select form-select-sm" @bind="file.FileType">
                                                            <option value="">Seleccionar tipo</option>
                                                            <option value="document">Documento</option>
                                                            <option value="multimedia">Multimedia</option>
                                                            <option value="image">Imagen</option>
                                                            <option value="other">Otro</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <UploadFileComponent Label=""
                                                                           FileType="@file.FileType"
                                                                           @bind-Value="file.FileUrl" />
                                                    </div>
                                                    <div class="col-md-1">
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => RemoveAdditionalFile(index)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center text-muted py-3">
                                        <i class="fas fa-file-circle-plus fa-2x mb-2"></i>
                                        <p class="mb-0">No hay archivos adicionales</p>
                                        <small>Haz clic en "Agregar Archivo" para añadir más archivos</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </form>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                @if (Headers.Length > 0)
                {
                    <button type="button" class="btn btn-primary" @onclick="SaveRow" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <span>Guardar Fila</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string[] Headers { get; set; } = [];
    [Parameter] public EventCallback<CatalogRow> OnRowSaved { get; set; }

    private string[] ColumnValues = Array.Empty<string>();
    private RowFiles RowFiles = new();
    private List<RowFileAttachment> AdditionalFiles = new();
    private bool isSaving = false;

    // Listas para archivos múltiples
    private List<string> DocumentUrls = new() { "" };
    private List<string> MultimediaUrls = new() { "" };
    private List<string> ImageUrls = new() { "" };

    protected override void OnInitialized()
    {
        ResetForm();
    }

    protected override void OnParametersSet()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        ColumnValues = new string[Headers.Length];
        RowFiles = new RowFiles();
        AdditionalFiles = new List<RowFileAttachment>();
        DocumentUrls = new() { "" };
        MultimediaUrls = new() { "" };
        ImageUrls = new() { "" };
        isSaving = false;
    }

    // Métodos para Documentos
    private void AddDocument()
    {
        DocumentUrls.Add("");
        StateHasChanged();
    }

    private void UpdateDocument(int index, string value)
    {
        if (index >= 0 && index < DocumentUrls.Count)
        {
            DocumentUrls[index] = value;
        }
    }

    private void RemoveDocument(int index)
    {
        if (index >= 0 && index < DocumentUrls.Count && DocumentUrls.Count > 1)
        {
            DocumentUrls.RemoveAt(index);
            StateHasChanged();
        }
    }

    // Métodos para Multimedia
    private void AddMultimedia()
    {
        MultimediaUrls.Add("");
        StateHasChanged();
    }

    private void UpdateMultimedia(int index, string value)
    {
        if (index >= 0 && index < MultimediaUrls.Count)
        {
            MultimediaUrls[index] = value;
        }
    }

    private void RemoveMultimedia(int index)
    {
        if (index >= 0 && index < MultimediaUrls.Count && MultimediaUrls.Count > 1)
        {
            MultimediaUrls.RemoveAt(index);
            StateHasChanged();
        }
    }

    // Métodos para Imágenes
    private void AddImage()
    {
        ImageUrls.Add("");
        StateHasChanged();
    }

    private void UpdateImage(int index, string value)
    {
        if (index >= 0 && index < ImageUrls.Count)
        {
            ImageUrls[index] = value;
        }
    }

    private void RemoveImage(int index)
    {
        if (index >= 0 && index < ImageUrls.Count && ImageUrls.Count > 1)
        {
            ImageUrls.RemoveAt(index);
            StateHasChanged();
        }
    }

    private void AddAdditionalFile()
    {
        AdditionalFiles.Add(new RowFileAttachment
        {
            FileType = "other",
            Description = ""
        });
    }

    private void RemoveAdditionalFile(int index)
    {
        if (index >= 0 && index < AdditionalFiles.Count)
        {
            AdditionalFiles.RemoveAt(index);
        }
    }

    private async Task SaveRow()
    {
        try
        {
            isSaving = true;

            // Validar que al menos un campo tenga valor
            if (ColumnValues.All(string.IsNullOrWhiteSpace))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Debes ingresar al menos un valor en alguna columna.");
                return;
            }

            // Crear la fila
            var newRow = new CatalogRow
            {
                Data = new Dictionary<string, object>(),
                Files = new RowFiles(),
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            // Llenar los datos de las columnas
            for (int i = 0; i < Headers.Length; i++)
            {
                var header = Headers[i];
                var value = ColumnValues[i];
                newRow.Data[header] = string.IsNullOrWhiteSpace(value) ? "" : value;
            }

            // Agregar archivos de las listas (solo los que no están vacíos)
            newRow.Files.Documents = DocumentUrls.Where(url => !string.IsNullOrEmpty(url)).ToList();
            newRow.Files.MultimediaFiles = MultimediaUrls.Where(url => !string.IsNullOrEmpty(url)).ToList();
            newRow.Files.Images = ImageUrls.Where(url => !string.IsNullOrEmpty(url)).ToList();

            // Mantener compatibilidad con campos legacy
            newRow.Files.Document = DocumentUrls.FirstOrDefault(url => !string.IsNullOrEmpty(url));
            newRow.Files.Multimedia = MultimediaUrls.FirstOrDefault(url => !string.IsNullOrEmpty(url));
            newRow.Files.Image = ImageUrls.FirstOrDefault(url => !string.IsNullOrEmpty(url));

            // Agregar archivos adicionales
            newRow.Files.AdditionalFiles = AdditionalFiles.Where(f => !string.IsNullOrEmpty(f.FileUrl)).ToList();

            var totalFiles = newRow.Files.Documents.Count + newRow.Files.MultimediaFiles.Count +
                           newRow.Files.Images.Count + newRow.Files.AdditionalFiles.Count;

            Logger.LogInformation("[AddRowModal] Guardando nueva fila con {ColumnCount} columnas y {FileCount} archivos",
                Headers.Length, totalFiles);

            // Notificar al componente padre
            await OnRowSaved.InvokeAsync(newRow);

            // Cerrar modal
            await JSRuntime.InvokeVoidAsync("hideModal", "addRowModal");

            // Resetear formulario
            ResetForm();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[AddRowModal] Error al guardar fila");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al guardar la fila: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .modal-xl {
        max-width: 1200px;
    }

    .card-body.py-2 {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
    }
</style>
