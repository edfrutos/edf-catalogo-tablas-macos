{
    "//": "=== CONFIGURACIÓN COMÚN MULTIPLATAFORMA ===",
    "workbench.editor.empty.hint": "hidden",
    "security.workspace.trust.untrustedFiles": "open",
    "editor.inlineSuggest.showToolbar": "always",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    
    "//": "=== FORMATTERS COMUNES ===",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    
    "//": "=== PYTHON CONFIGURACIÓN ===",
    "python.analysis.typeCheckingMode": "basic",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.debugging.debugJustMyCode": false,
    "python.analysis.diagnosticSeverityOverrides": {},
    
    "//": "=== GITHUB COPILOT CONFIGURACIÓN ===",
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.advanced": {
        "terminal.enableTerminalCommands": true,
        "debug.enableDebuggerCommands": true,
        "search.enableFullFileSearch": true
    },
    "github.copilot.chat": {
        "enableAI": true,
        "enableCodeAnalysis": true,
        "enableContextualSuggestions": true,
        "localeOverride": "es"
    },
    
    "//": "=== CONFIGURACIONES ESPECÍFICAS DE LINUX ===",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.env.linux": {},
    
    "//": "=== RUTAS Y CONFIGURACIONES ESPECÍFICAS DE LINUX ===",
    "remote.SSH.remotePlatform": {
        "*.gitpod.io": "linux",
        "localhost": "linux"
    },
    
    "//": "=== SPELL CHECKER ===",
    "cSpell.userWords": [
        "faltan",
        "geeksforgeeks",
        "myqr",
        "pyqrcode",
        "strftime",
        "linux",
        "ubuntu",
        "catalogotablas"
    ],
    
    "//": "=== CONFIGURACIONES DE DESARROLLO ===",
    "makefile.configureOnOpen": true,
    "diffEditor.codeLens": true,
    "console-ninja.featureSet": "Community",
    "console-ninja.toolsToEnableSupportAutomaticallyFor": {
        "live-server-extension": true,
        "live-preview-extension": true
    },
    
    "//": "=== CONFIGURACIONES DE CHAT Y HERRAMIENTAS ===",
    "chat.agent.maxRequests": 1000,
    "chat.mcp.autostart": "newAndOutdated",
    "continue.showInlineTip": false,
    
    "//": "=== WORKBENCH SETTINGS ===",
    "workbench.colorCustomizations": {},
    "vsicons.dontShowNewVersionMessage": true
}