@page "/forgot-password"
@model EDFCatalogoTablasNet.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="col-md-5 col-sm-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="fas fa-key fa-3x text-primary mb-3"></i>
                    <h3 class="text-primary">¿Olvidaste tu contraseña?</h3>
                    <p class="text-muted">No te preocupes, te ayudaremos a recuperarla</p>
                </div>

                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @Model.ErrorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model?.SuccessMessage))
                {
                    <div class="alert alert-success" role="alert">
                        <i class="fas fa-check-circle me-2"></i>
                        @Model.SuccessMessage
                    </div>
                }

                @if (Model != null && !Model.EmailSent)
                {
                    <form method="post">
                        <div class="form-group mb-4">
                            <label for="Email" class="form-label">
                                <i class="fas fa-envelope me-2"></i>Correo electrónico
                            </label>
                            <input asp-for="Email" name="Email" class="form-control form-control-lg"
                                   placeholder="tu.email@empresa.com"
                                   value="@(Model?.Email ?? string.Empty)" />
                            <small class="form-text text-muted mt-2">
                                Ingresa el email con el que te registraste y te enviaremos instrucciones para restablecer tu contraseña.
                            </small>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="fas fa-paper-plane me-2"></i>
                            Enviar instrucciones
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center">
                        <div class="alert alert-info border-info" role="alert">
                            <i class="fas fa-envelope fa-3x mb-3 d-block"></i>
                            <h5>¡Revisa tu email!</h5>
                            <p class="mb-0">
                                Hemos enviado las instrucciones de recuperación a <strong>@(Model?.Email ?? "")</strong>.
                                <br><br>
                                <small class="text-muted">
                                    Si no recibes el email en unos minutos, revisa tu carpeta de spam.
                                </small>
                            </p>
                        </div>
                        <a href="/login" class="btn btn-primary mt-3">
                            <i class="fas fa-sign-in-alt me-2"></i>Volver al inicio de sesión
                        </a>
                    </div>
                }

                <hr>

                <div class="text-center">
                    <p class="mb-2">¿Recordaste tu contraseña?</p>
                    <a href="/login" class="btn btn-outline-primary btn-sm me-2">
                        <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                    </a>
                    <a href="/register" class="btn btn-outline-success btn-sm">
                        <i class="fas fa-user-plus me-2"></i>Crear Cuenta
                    </a>
                </div>
            </div>
        </div>

        <!-- Nota informativa -->
        <div class="alert alert-warning mt-3 text-center" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            <small>
                <strong>Nota de demostración:</strong> Esta es una implementación de ejemplo.
                En producción, el enlace de recuperación se enviaría por email real.
            </small>
        </div>
    </div>
</div>

