@page "/test-login"
@model EDFCatalogoTablasNet.Pages.TestLoginModel
@{
    ViewData["Title"] = "Login de Prueba";
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
    <div class="col-md-4 col-sm-6">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h3 class="text-primary">🧪 Login de Prueba</h3>
                    <p class="text-muted">Para testing del sistema de autenticación</p>
                </div>

                <form method="post">
                    <div class="d-grid">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-key me-2"></i>
                            Autenticar como Admin
                        </button>
                    </div>
                </form>

                <hr>

                <div class="text-center">
                    <small class="text-muted">
                        <strong>Nota:</strong> Este endpoint es solo para pruebas de desarrollo.<br>
                        Autentica automáticamente con admin@edf.com
                    </small>
                </div>

                <div class="text-center mt-3">
                    <a href="/login" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>
                        Volver al Login Normal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
