# Razor-specific configuration
[*.razor]
# Suppress false positive warnings for component recognition
dotnet_diagnostic.RZ10012.severity = none

# Suppress other common Razor false positives
dotnet_diagnostic.RZ10013.severity = none
dotnet_diagnostic.RZ10014.severity = none

# Keep important warnings
dotnet_diagnostic.RZ10001.severity = warning
dotnet_diagnostic.RZ10002.severity = warning
