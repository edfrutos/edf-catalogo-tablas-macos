# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# 4 space indentation for most files
[*.{cs,csx,vb,vbx}]
indent_style = space
indent_size = 4

# 2 space indentation for web files
[*.{js,jsx,ts,tsx,json,yml,yaml,html,css,scss,md}]
indent_style = space
indent_size = 2

# Tab indentation for Makefiles
[Makefile]
indent_style = tab

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Configuration files
[*.{config,conf,ini}]
indent_style = space
indent_size = 2

# Markdown files - no trailing whitespace trimming to preserve intentional line breaks
[*.md]
trim_trailing_whitespace = false

# Razor files - suppress specific warnings
[*.razor]
# Suppress RZ10012 warnings about unexpected markup elements (false positives for components)
dotnet_diagnostic.RZ10012.severity = none
dotnet_diagnostic.RZ10013.severity = none
dotnet_diagnostic.RZ10014.severity = none
# Keep important Razor warnings
dotnet_diagnostic.RZ10001.severity = warning
dotnet_diagnostic.RZ10002.severity = warning
